{
  "name": "prisma-rls",
  "version": "1.0.1",
  "description": "Prisma client extension for row-level security on any database",
  "license": "MIT",
  "keywords": [
    "database",
    "prisma",
    "prisma-client",
    "prisma-extension",
    "rls",
    "row-level-security"
  ],
  "author": "s1owjke",
  "homepage": "https://github.com/s1owjke/prisma-rls",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "build:watch": "rm -rf dist && tsc --watch",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@prisma/client": ">=7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/internals": "^7.9.1",
    "@types/node": "^20.19.43",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
